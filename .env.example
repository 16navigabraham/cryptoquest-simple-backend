# ===========================================
# CRYPTOQUEST BACKEND V4.0 CONFIGURATION
# ===========================================

# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DB_NAME=cryptoquest

# OpenAI Configuration (REQUIRED)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Blockchain Configuration (REQUIRED for rewards)
PRIVATE_KEY=your_wallet_private_key_here
RPC_URL=https://sepolia.base.org
CONTRACT_ADDRESS=your_badge_contract_address_here
CHAIN_ID=84532

# JWT Configuration
JWT_SECRET=cryptoquest-secret-key-change-in-production
JWT_EXPIRES_IN=24h

# ===========================================
# SETUP INSTRUCTIONS
# ===========================================

# 1. MongoDB Setup:
#    - Install MongoDB locally or use MongoDB Atlas
#    - Update MONGODB_URI with your connection string
#    - Example: mongodb+srv://username:password@cluster.mongodb.net/cryptoquest

# 2. OpenAI API Setup:
#    - Sign up at https://platform.openai.com/
#    - Create an API key in your account dashboard
#    - Replace OPENAI_API_KEY with your actual key
#    - Note: You'll need credits for quiz generation

# 3. Blockchain Setup (Base Sepolia):
#    - Create a wallet for the backend (MetaMask, etc.)
#    - Get Base Sepolia ETH from faucet: https://bridge.base.org/
#    - Deploy your badge NFT contract or use existing one
#    - Replace PRIVATE_KEY with wallet's private key (WITHOUT 0x prefix)
#    - Replace CONTRACT_ADDRESS with deployed contract address

# 4. Badge Contract Example (Solidity):
#    You can use OpenZeppelin's ERC721 with the following functions:
#    - safeMint(address to, uint256 tokenId)
#    - balanceOf(address owner)
#    - tokenOfOwnerByIndex(address owner, uint256 index)

# 5. Optional: Custom RPC
#    You can use Alchemy, Infura, or other providers:
#    RPC_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# ===========================================
# PRODUCTION DEPLOYMENT
# ===========================================

# For production, make sure to:
# 1. Set NODE_ENV=production
# 2. Use strong JWT_SECRET (generate random string)
# 3. Use environment-specific MongoDB URI
# 4. Keep PRIVATE_KEY secure (use secrets manager)
# 5. Monitor your OpenAI usage and costs

# ===========================================
# EXAMPLE PRODUCTION VALUES
# ===========================================

# NODE_ENV=production
# MONGODB_URI=mongodb+srv://user:pass@prod-cluster.mongodb.net/cryptoquest
# OPENAI_API_KEY=sk-your-production-openai-key
# PRIVATE_KEY=your-secure-production-wallet-private-key
# CONTRACT_ADDRESS=0x1234567890123456789012345678901234567890
# JWT_SECRET=super-secure-random-string-for-production
# RPC_URL=https://mainnet.base.org

# ===========================================
# DEVELOPMENT TIPS
# ===========================================

# 1. Test with Base Sepolia first before mainnet
# 2. Use small amounts of test ETH for minting
# 3. Monitor console logs for AI generation issues
# 4. Check /health endpoint to verify all services
# 5. Use /api/ endpoints with proper CORS origins

# ===========================================
# CORS ORIGINS (automatically configured)
# ===========================================
# The following origins are allowed by default:
# - http://localhost:3000 (React dev)
# - http://localhost:5173 (Vite dev)
# - http://localhost:3001 (Backend)
# - https://abrahamnavig-quest.vercel.app (Production frontend)